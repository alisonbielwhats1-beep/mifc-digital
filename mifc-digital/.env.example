NODE_ENV=development
API_PORT=5174

# Projeto Power BI de referência; não editar a pasta original.
# Na organização local atual, o PBIP fica ao lado de mifc-digital.
MIFC_PBIP_PATH=../mifc-pbip

# Oracle MES — preencher somente no ambiente local da Metalsa.
ORACLE_HOST=
ORACLE_PORT=1521
ORACLE_SERVICE_NAME=
ORACLE_USER=
ORACLE_PASSWORD=

# Proteções obrigatórias.
ORACLE_READ_ONLY=true
ORACLE_LIVE_READS_ENABLED=true
# Intervalo padrão para tabelas sem frequência própria no catálogo (mínimo: 60 s).
ORACLE_AUTO_REFRESH_SECONDS=300
ORACLE_QUERY_CATALOG_PATH=apps/api/config/oracle-query-catalog.json
