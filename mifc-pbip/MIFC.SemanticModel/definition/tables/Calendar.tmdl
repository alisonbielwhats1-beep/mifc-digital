	partition Calendar = calculated
		mode: import
		source =
				ADDCOLUMNS(
				    CALENDAR(
				        TODAY()-7,TODAY()+10),
				        "Ano",
				        YEAR([Date]),
				        "Mês",
				        MONTH([Date]),
				        "Dia",
				        DAY([Date]),
				        "Dia_Min",
				        IF(
				            [Date] = TODAY(), (HOUR(NOW()) * 60) + MINUTE(NOW()), 1440))

	annotation PBI_Id = 27ac8492d105449a91c22078643bb0eb

