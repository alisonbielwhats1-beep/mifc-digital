	measure Q-G-SCA = ```
			--Quantidade de Golpes Scania
			
			var valor1 =
			CALCULATE(
			    SUM(
			        BI_PUNCH_SCA[ALMA]),
			        FILTER(
			            BI_PUNCH_SCA,
			            BI_PUNCH_SCA[CHASSIS_NUMBER]
			        )
			            
