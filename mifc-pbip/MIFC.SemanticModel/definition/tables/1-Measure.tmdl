	measure Q-P-ShipDate = ```
			
			-- Quantidade de Peças ShipDate
			
			VAR soma_sca = 
			COUNTX(
			    FILTER(
			        SCANIA,
			        SCANIA[FINISH_LENGHT] <> BLANK() && SCANIA[LOCAL] = "Slitter"
			    ),
			    SCANIA[CHASSIS_NUMBER]
			)
			
			VAR soma_fh = 
			COUNTX(
			    FILTER(
			        FH,
			        FH[FINISH_LENGHT] <> BLANK() && FH[LOCAL] = "Slitter"
			    ),
			    FH[CHASSIS_NUMBER]
			)
			
			VAR soma_vm = 
			COUNTX(
			    FILTER(
			        VM,
			        VM[FINISH_LENGHT] <> BLANK() && VM[LOCAL] = "Slitter"
			    ),
			    VM[CHASSIS_NUMBER]
			)
			
			VAR soma_daf = 
			SUMX(
			    FILTER(
			        'DAF SLITTERS',
			        'DAF SLITTERS'[FINISH_LENGTH] <> BLANK() && 'DAF SLITTERS'[LOCAL] = "Slitter"
			    ),
			    'DAF SLITTERS'[Pares Slitter] * 2 
			)
			
			RETURN
			    soma_sca + soma_fh + soma_vm + soma_daf
			
			```
		formatString: 0
		displayFolder: ALL\0.0.MIFC\Logística
		lineageTag: 8640e3bf-709f-4f6b-bde0-9c95723cb06a

