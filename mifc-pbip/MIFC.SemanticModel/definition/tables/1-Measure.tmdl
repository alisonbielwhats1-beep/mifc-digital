	measure %P-RF3 =
			
			
			([P-RF3] / [D-P-RF3])
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: ALL\Máquinas\0.Roll Former 3
		lineageTag: 80835230-80de-4bc2-9099-8d7836efd8fd

	measure T-L-H-RF3 =
			-- Tempo Liquído Hora RF3
			(60-[P-P-RF3])
		displayFolder: ALL\Máquinas\0.Roll Former 3
		lineageTag: ec6a4742-547a-4582-ab6d-ad9e112ddb44

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure TKT-H-RF3 =
			--Takt Time Hora RF3
			
			[T-L-H-RF3] / [TKT-C-RF3]
		formatString: 0
		displayFolder: ALL\Máquinas\0.Roll Former 3
		lineageTag: eb811487-ed7a-49e8-863b-0feab48abc9d

	measure Q-P-T =
			--Quantidade de Paradas totais
			
			DISTINCTCOUNT(
			    Paradas[ID_PARADA]
			)
		formatString: 0
		lineageTag: bbd46be4-6a27-43e4-94f2-694c0b95fa50

	measure DT-RF3 =
			--DownTime Rollformer III
			
			CALCULATE(
			    SUMX(Paradas,
			    Paradas[RETORNO] - Paradas[PARADA]) * 1440 ,
			    Paradas[OPERAÇÃO] = "ROLLFORMER 3"
			)  - [P-P-RF3]
		displayFolder: ALL\Máquinas\0.Roll Former 3
		lineageTag: 0cb6b3d9-ba8c-456c-a4ad-3156eb20d6b3

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure PT-RF3 =
			--Paradas Totais Rollformer III
			
			CALCULATE(
			    SUMX(Paradas,
			    Paradas[RETORNO] - Paradas[PARADA]) * 1440 ,
			    Paradas[OPERAÇÃO] = "ROLLFORMER 3"
			)
		displayFolder: ALL\Máquinas\0.Roll Former 3
		lineageTag: 741f78b6-862f-4dcf-b5ba-c2cba708003a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure P-S-T = ```
			-- Peso Slliter em Toneladas
			
			FORMAT(DIVIDE(SUM(Lotes[PESO]), 1000), "0.0") & " ton"
			
			```
		displayFolder: ALL\Logística
		lineageTag: b9a508b8-49c3-497c-873a-fdd34a457857

	measure Q-D-E-T =
			-- Quantidade de Dias Ship Date Geral
			
			[Q-D-E-DAF] + [Q-D-E-FH] + [Q-D-E-SCA] + [Q-D-E-VM]
		formatString: 0
		displayFolder: ALL\Logística
		lineageTag: 07e50cf2-f9aa-4213-9f8e-4c632a8f05b2

	measure Q-P-ShipDate+Acum = ```
			
			-- Quantidade de Peças Acumuladas por Data
			
			CALCULATE(
			    COUNTX(
			        FILTER(
			            SCANIA,
			            SCANIA[FINISH_LENGHT] <> BLANK() && SCANIA[LOCAL] = "Slitter"
			        ),
			        SCANIA[CHASSIS_NUMBER]
			    ) +
			    COUNTX(
			        FILTER(
			            FH,
			            FH[FINISH_LENGHT] <> BLANK() && FH[LOCAL] = "Slitter"
			        ),
			        FH[CHASSIS_NUMBER]
			    ) +
			    COUNTX(
			        FILTER(
			            VM,
			            VM[FINISH_LENGHT] <> BLANK() && VM[LOCAL] = "Slitter"
			        ),
			        VM[CHASSIS_NUMBER]
			    ) +
			    SUMX(
			        FILTER(
			            'DAF SLITTERS',
			            'DAF SLITTERS'[FINISH_LENGTH] <> BLANK() && 'DAF SLITTERS'[LOCAL] = "Slitter"
			        ),
			        'DAF SLITTERS'[Pares Slitter] * 2
			    ),
			    FILTER(
			        ALL('Calendar'),
			        'Calendar'[Date] <= MAX('Calendar'[Date])
			    )
			)
			
			```
		displayFolder: ALL\Logística
		lineageTag: 6acca57a-5e1e-4139-9c21-232331f1217a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure R-L-MP = ```
			-- Regra Logística MP 
			CALCULATE(
			 [E-M-P-S],ALL(
			    'Calendar'[Date]
			 )
			) - [Q-P-ShipDate+Acum]
			```
		displayFolder: ALL\Logística
		lineageTag: f08b1de3-b0d0-45dc-bc08-97b7cc207ac4

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure R-L-COND-MP = ```
			-- Regra Logística Condicional MP  
			
			IF(
			    [R-L-MP] <=0, " " & "Qtd" & " " & "=" & " " & ([R-L-MP] *-1) & " " & "(" &
			    SELECTEDVALUE(
			        'Calendar'[Date]
			    ) & ")"
			)
			```
		displayFolder: ALL\Logística
		lineageTag: 686d4c75-2941-4663-bfa8-0412dceac73e

	measure Q-G-M-SCA =
			-- Quantidade de Golpes Médios
			
			 [Q-G-SCA]/[Scania]
		displayFolder: ALL\Capacidade-Online
		lineageTag: c0d705e4-3d83-4910-9e3a-cfd23a474ef8

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure C-M-E = ```
			-- Comprimento Peças a serem Embaladas
			VAR soma_sca = 
			SUMX(
			    FILTER(
			        SCANIA,
			        SCANIA[FINISH_LENGHT] <> BLANK() && SCANIA[LOCAL] <> "Estoque FG"
			    ),
			    SCANIA[FINISH_LENGHT]
			)
			
			VAR soma_fh = 
			SUMX(
			    FILTER(
			        FH,
			        FH[FINISH_LENGHT] <> BLANK() && FH[LOCAL] <> "Estoque FG"
			    ),
			    FH[FINISH_LENGHT]
			)
			
			VAR soma_vm = 
			SUMX(
			    FILTER(
			        VM,
			        VM[FINISH_LENGHT] <> BLANK() && VM[LOCAL] <> "Estoque FG"
			    ),
			    VM[FINISH_LENGHT]
			)
			
			VAR soma_daf = 
			SUMX(
			    FILTER(
			        'DAF SLITTERS',
			        'DAF SLITTERS'[FINISH_LENGTH] <> BLANK() && 'DAF SLITTERS'[LOCAL] <> "Estoque FG"
			    ),
			    ('DAF SLITTERS'[Pares Slitter] * 2) * 'DAF SLITTERS'[FINISH_LENGTH]
			)
			
			RETURN
			    soma_sca + soma_fh + soma_vm + soma_daf
			
			```
		lineageTag: 10adb73f-ba3c-4897-bbba-9644c2f521e9

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Q-P-E =
			-- Peças a serem Embaladas
			
			CALCULATE(
			    [Scania] ,
			    SCANIA[local] <> "Estoque FG"
			) +
			CALCULATE(
			    [FH] ,
			    FH[local] <> "Estoque FG"
			)+
			CALCULATE(
			    [VM] ,
			    VM[local] <> "Estoque FG"
			)+
			CALCULATE(
			    [DAF] ,
			    DAF[Local] <> "Estoque FG"
			)
		formatString: 0
		lineageTag: 87faf497-d362-4c66-ad08-81c03413825e

	measure Q-P-R = ```
			-- Quantidade Reforçada
			
			(CALCULATE(
			    COUNTROWS(SCANIA),
			    SCANIA[TIPO] = "Reforço" && SCANIA[local] <> "Estoque FG"
			) / 2) +
			(CALCULATE(
			    COUNTROWS(FH),
			    FH[TIPO] = "Reforço" && FH[local] <> "Estoque FG"
			) / 2) +
			(CALCULATE(
			    COUNTROWS(VM),
			    VM[Tipo] = "Reforço" && VM[local] <> "Estoque FG"
			) / 2) +
			(CALCULATE(
			    COUNTROWS(DAF),
			    DAF[RAIL_TYPE_DESCRIPTION] = "Reforço" && DAF[Local] <> "Estoque FG"
			) / 2)
			
			```
		lineageTag: 3229947b-f3ae-4073-b3a5-7d51c5f7568a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'qtd_segregação cc' =
			CALCULATE(
			    DISTINCTCOUNT(Segregacao[RAIL_ID]),Segregacao[Processos e ENNs.ENN] = "Corte e Conformação"
			)
		formatString: 0
		displayFolder: ALL\0.0.MIFC\Qualidade
		lineageTag: aa450e5a-d6b2-4cbd-99ff-ce8ac93e6965

	measure Q-D-S-RF2 = ```
			-- Quantidade de Dias Segregados RF2    
			DIVIDE(
			    CALCULATE(
			        [qtd_segregação cc],
			        FILTER(Segregacao, Segregacao[LOCATION] = "Rollformer 2")
			    ),
			    CALCULATE(
			        [D-P-RF2],
			        'Calendar'[Date] = TODAY()
			    )
			)
			
			```
		formatString: 0.000
		lineageTag: aa812100-c5c8-49b2-a7bd-405651980e1f

	measure Q-D-S-LPP2 = ```
			-- Quantidade de Dias Segregados Pintura
			DIVIDE(
			    CALCULATE(
			        [qtd_segregação pintura],
			        FILTER(
			            Segregacao, 
			            Segregacao[LOCATION] = "Pintura Input 2" || Segregacao[LOCATION] = "Pintura Output 2"
			        )
			    ),
			    CALCULATE(
			        [D-P-LPP2],
			        'Calendar'[Date] = TODAY()
			    )
			)
			
			```
		formatString: 0.000
		lineageTag: 414c2a79-a0f9-4d5d-8e1f-7da3e08c6397

	measure T-N-E-P = ```
			-- Tempo Necessário para embalar peças
			
			
			    [T-N-E-P-DAF] + [T-N-E-P-FH] + [T-N-E-P-SCA] 
			```
		formatString: 0.0
		lineageTag: 038efeae-7858-4355-8daf-185dd946800e

	measure Carros_DAF_CARGA = ((SUM(DAF[QTD long Reforçada]))/2)+((SUM(DAF[QTD long SIMPLES]))/2) + CALCULATE(sum('DAF SLITTERS'[Pares Slitter]),FILTER('DAF SLITTERS', 'DAF SLITTERS'[RAIL_TYPE]="M"))
		lineageTag: bd9b4b64-574c-4053-be0c-1922517548f6

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Carros_FH_CARGA = CALCULATE(DISTINCTCOUNT(FH[CHASSIS_NUMBER]))
		formatString: 0
		lineageTag: 1f3d722a-95d4-40a9-93fd-91403a624231

	measure Carros_VM_CARGA = CALCULATE(DISTINCTCOUNT(VM[CHASSIS_NUMBER]))
		formatString: 0
		lineageTag: f6d59b90-a450-4e97-868b-7b07f2f3f9d8

	measure Carros_SCASB_CARGA =
			// Conta o número de chassis que não se repetem para o cliente scania
			
			
			CALCULATE(DISTINCTCOUNT(SCANIA[CHASSIS_NUMBER]))
		formatString: 0
		lineageTag: 597cc061-9e5f-48f8-94dd-ecc67276bef4

	measure Carros_SCASB_CARGA_N-EMB =
			// Conta o número de chassis que não se repetem para o cliente scania que não estão na embalagem
			
			
			CALCULATE(DISTINCTCOUNT(SCANIA[CHASSIS_NUMBER]),SCANIA[local_revisado stenhoj] <> "Estoque FG" && SCANIA[local_revisado stenhoj] <> BLANK())
		formatString: 0
		lineageTag: 92a9a85e-97aa-4a4e-9ec6-2f26151f06c5

	measure Carros_VM_CARGA_N-EMB = CALCULATE(DISTINCTCOUNT(VM[CHASSIS_NUMBER]),VM[local]<>"Estoque FG")
		formatString: 0
		lineageTag: 61c75bdd-7471-4a39-ba8f-cb5c8f84f917

	measure Carros_FH_CARGA_N-EMB = CALCULATE(DISTINCTCOUNT(FH[CHASSIS_NUMBER]),FH[local]<>"Estoque FG")
		formatString: 0
		lineageTag: 269bc64b-ff7e-4045-893b-2b1c6e0e77b0

	measure T-N-E-P-VM = ```
			-- Tempo Necessário para embalar carros VM
			    CALCULATE(
			        [Q-P-R], 
			        VM[local] <> "Estoque FG", 
			        MP[Cliente] = "VM"
			
			    ) * 
			    CALCULATE(
			        SUM('Emb Reta'[Tempo de processamento (min)]), 
			        'Emb Reta'[Cliente] = "Volvo VM Reforçada"
			    )
			 +
			(
			    CALCULATE(
			        ([Carros_VM_CARGA] - [Q-P-R]), 
			        VM[local] <> "Estoque FG", 
			        MP[Cliente] = "VM"
			    ) * 
			    CALCULATE(
			        SUM('Emb Reta'[Tempo de processamento (min)]), 
			        'Emb Reta'[Cliente] = "Volvo VM Simples"
			    ))
			```
		formatString: 0.0
		lineageTag: 9564f384-4723-4fcd-8fc4-1d59908323dd

	measure T-N-E-P-FH = ```
			-- Tempo Necessário para embalar carros FH
			
			
			    (CALCULATE(
			        [Q-P-R], 
			        FH[local] <> "Estoque FG", 
			        FH[Tipo] = "Reforço",
			        MP[Cliente] = "FH"
			    ) * 
			    CALCULATE(
			        SUM('Emb Offset'[Tempo de processamento (min)]), 
			        'Emb Offset'[Cliente] = "Volvo FH Reforçado"
			    ) 
			) +
			(
			    (CALCULATE(
			        ([Carros_FH_CARGA] - [Q-P-R]), 
			        FH[local] <> "Estoque FG", 
			        FH[Tipo] <> "Reforço",
			        MP[Cliente] = "FH"
			    ) * 
			    CALCULATE(
			        SUM('Emb Offset'[Tempo de processamento (min)]), 
			        'Emb Offset'[Cliente] = "Volvo FH Simples"
			    )
			))
			```
		formatString: 0.0
		lineageTag: fa277433-03b0-4c94-a7cf-eb88f2c75fef

	measure T-N-E-P-SCA = ```
			-- Tempo Necessário para embalar carros Scania
			
			
			    (CALCULATE(
			    [Carros_SCASB_CARGA],
			    SCANIA[local] <> "Estoque FG",
			    MP[Cliente] = "Scania"
			    ) * 
			   CALCULATE(
			        SUM('Emb Offset'[Tempo de processamento (min)]), 
			        'Emb Offset'[Cliente] = "Scania"
			   )
			    )
			```
		formatString: 0.0
		lineageTag: 3e0b9d28-f35f-40ff-88e9-e17610ba1041

	measure T-N-E-P-DAF = ```
			-- Tempo Necessário para embalar carros DAF
			
			(
			    CALCULATE(
			        [Carros_DAF_CARGA], 
			        DAF[Local] <> "Estoque FG"
			    
			    ) * 
			    CALCULATE(
			        SUM('Emb Offset'[Tempo de processamento (min)]), 
			        'Emb Offset'[Cliente] = "DAF",
			        MP[Cliente] = "DAF"
			    )
			)
			```
		lineageTag: 685f55ff-4afb-4cda-944c-15fbe4a9fb01

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Carros_DAF_CARGA_N-EMB = ```
			
			CALCULATE(
			    (SUM(DAF[QTD long Reforçada])/2) + 
			    (SUM(DAF[QTD long SIMPLES])/2) + 
			    SUMX(
			        FILTER('DAF SLITTERS', 'DAF SLITTERS'[RAIL_TYPE] = "M"), 
			        'DAF SLITTERS'[Pares Slitter]
			    ),DAF[Local] <> "Estoque FG"
			)
			
			```
		lineageTag: 3da46597-1ee6-4090-8f65-00037fde9453

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure T-N-E-P-H = ```
			-- Tempo Necessário para embalar peças (horas)
			
			VAR horas =
			    [T-N-E-P-DAF] + [T-N-E-P-FH] + [T-N-E-P-SCA] 
			
			    return
			
			    horas / 60
			```
		formatString: 0.0
		lineageTag: 11399bd1-2a49-4348-857e-857327fc1121

	measure Carros_Total_N-EMB = ```
			
			
			 [Carros_SCASB_CARGA_N-EMB] + [Carros_FH_CARGA_N-EMB] + [Carros_DAF_CARGA_N-EMB]
			```
		lineageTag: e4c1b858-771c-42e1-81b0-03e7da86cfa8

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Carros_Total-EMB = ```
			
			
			 [Carros_SCASB_CARGA] + [Carros_FH_CARGA] + [Carros_DAF_CARGA]
			```
		lineageTag: 588d023f-0fb0-45e9-8647-eb4946a1b7fc

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Q-D-S-RF3 = ```
			-- Quantidade de Dias Segregados RF3    
			DIVIDE(
			    CALCULATE(
			        [qtd_segregação cc],
			        FILTER(Segregacao, Segregacao[LOCATION] = "Roll Former 3")
			    ),
			    CALCULATE(
			        [D-P-RF3],
			        'Calendar'[Date] = TODAY()
			    )
			)
			
			```
		formatString: 0.000
		lineageTag: 0bce7ea0-8893-4c8d-b396-c911f996d584

	measure Q-D-S-STJ = ```
			-- Quantidade de Dias Segregados Stenhoj    
			DIVIDE(
			    CALCULATE(
			        [qtd_segregação see],
			        FILTER(Segregacao, Segregacao[LOCATION] = "Stenhoj")
			    ),
			    CALCULATE(
			        [D-P-STJ],
			        'Calendar'[Date] = TODAY()
			    )
			)
			
			```
		formatString: 0.000
		lineageTag: c085ac4c-3844-481f-a66a-1a973c4635b6

	measure Q-D-S-EMB = ```
			-- Quantidade de Dias Segregados Embalagem 
			DIVIDE(
			    CALCULATE(
			        [qtd_segregação see],
			        FILTER(Segregacao, Segregacao[LOCATION] IN {"Embalaje 1","Embalaje 3"})
			    ),
			    CALCULATE(
			        [D-P-LPP2],
			        'Calendar'[Date] = TODAY()
			    )
			)
			
			```
		formatString: 0.000
		lineageTag: 898b55ef-a011-402c-ac15-c3add3d1ecfa

	measure Q-D-S-T = ```
			-- Quantidade de Dias Segregados Total
			
			[Q-D-S-EMB] + [Q-D-S-LPP2] + [Q-D-S-RF2] + [Q-D-S-RF3] + [Q-D-S-STJ] 
			```
		formatString: 0.000
		lineageTag: da3e467a-83cd-42c1-a0eb-0aa54485455c

