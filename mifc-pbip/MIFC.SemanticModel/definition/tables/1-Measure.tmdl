	measure P-RF2 =
			--Produção Peças Roll Former 2
			SUM(
			    'Produção RF2'[_VALUE]
			)
		formatString: 0
		displayFolder: ALL\Máquinas\Roll Former 2
		lineageTag: 9810f211-f362-4b8b-bd06-dd78497c89de

	measure P-P-RF2 = ```
			--Paradas Programadas na Rollformer 2
			
			CALCULATE(
			    SUMX(Paradas,
			    Paradas[RETORNO] - Paradas[PARADA]) * 1440 ,
			    Paradas[CODIGO] IN {"L9", "O3", "M6", "O2"} && 
			    Paradas[OPERAÇÃO] = "ROLLFORMER 2"
			)
			```
		displayFolder: ALL\Máquinas\Roll Former 2
		lineageTag: dee84847-13ab-4fda-a4b7-9d294e11e546

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure D-P-RF2 =
			
			CALCULATE(
			    [T-I-FH],
			    FH[MP] = "4-MP600450SL411-0" || FH[MP] = "4-MP600760SL445-0"
			)
		formatString: 0
		displayFolder: ALL\0.0.MIFC\ALL\Demanda
		lineageTag: 460882cd-c936-4fe2-b58d-c6121f968e66

	measure T-D-L-RF2 = ```
			--Tempo Disponível Liquído Roll Former 2
			var valor =
			
			SUM(
			    'Calendar'[Dia_Min]
			) - [P-P-RF2]
			
			var fuso = 
			
			[F-H]
			
			return
			
			valor - fuso
			```
		displayFolder: ALL\Máquinas\Roll Former 2
		lineageTag: f3859387-f5a8-44da-996e-f856ea8944d9

		annotation PBI_FormatHint = {"isGeneralNumber":true}

