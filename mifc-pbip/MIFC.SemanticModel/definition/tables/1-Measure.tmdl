table 1-Measure
	lineageTag: 26d1f4ca-1627-42ee-bc26-ef1b1abdd48e

	measure P-RF3 =
			--Produção Peças Roll Former 3
			CALCULATE(
			    DISTINCTCOUNT(
			    'Produção'[RAIL_ID]),'Produção'[DESCRIPTION] ="Roll Former 3"
			)
		formatString: 0
		displayFolder: ALL\Máquinas\0.Roll Former 3
		lineageTag: 28f0b44e-eb05-4c99-bc66-8b6e54d59526

	measure T-D = ```
			--Tempo Disponível 
			
			SUM(
			    'Calendar'[Dia_Min]
			) 
			```
		formatString: 0
		displayFolder: ALL\0.0.MIFC\ALL
		lineageTag: a3fc2138-f922-4c53-85f0-9bc2ccc3115d

	measure TKT-C-RF3 =
			-- Takt Time Cliente RF3
			
			[T-P-M-RF3] / [D-P-RF3]
		formatString: 0.0000000000
		displayFolder: ALL\Máquinas\0.Roll Former 3
		lineageTag: cd1ff782-5d0f-4b2a-aaf0-36776ec89910

	measure T-P-M-RF3 =
			--Tempo de Produção Roll Former 3
			CALCULATE(
			
			SUM('Máquinas'[Tempo Disponível (Min)]),
			'Máquinas'[Máquina] = "Roll Former 3"
			)
		formatString: 0
		displayFolder: ALL\Máquinas\0.Roll Former 3
		lineageTag: 2d8aa38f-6b36-4847-aeac-8ffed42ec8f8

	measure D-P-RF3 =
			-- Demanda de Produção em Peças Roll Former 3
			[P-T-D] * 2
		formatString: 0
		displayFolder: ALL\Máquinas\0.Roll Former 3
		lineageTag: 25ace595-250a-4e0f-a93f-092d2037557f

	measure T-C-RF3 =
			--Tempo de Ciclo RF3
			
			[T-D-L-RF3]/[P-RF3]
		formatString: 0.0000000000
		displayFolder: ALL\Máquinas\0.Roll Former 3
		lineageTag: 2149e505-b609-4cc9-ab9b-d91ce58667f1

	measure T-R-RF3 =
			-- Tempo Restante Roll Former 3
			
			[T-P-M-RF3] - [T-D-L-RF3]
		formatString: 0
		displayFolder: ALL\Máquinas\0.Roll Former 3
		lineageTag: 4dae3cc9-a932-44d4-aa34-5409b069dab5

	measure P-P-RF3 = ```
			--Paradas Programadas na Rollformer III
			
			CALCULATE(
			    SUMX(Paradas,
			    Paradas[RETORNO] - Paradas[PARADA]) * 1440 ,
			    Paradas[CODIGO] IN {"L9", "O3", "M6", "O2"} && 
			    Paradas[OPERAÇÃO] = "ROLLFORMER 3"
			)
			```
		displayFolder: ALL\Máquinas\0.Roll Former 3
		lineageTag: 10dda649-d858-4b49-9a06-7251828de3c6

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure T-D-L-RF3 = ```
			--Tempo Disponível Liquído Roll Former 3
			var valor =
			
			
			SUM(
			    'Calendar'[Dia_Min]
			) - [P-P-RF3]
			
			
			var fuso =
			
			[F-H] 
			
			return
			
			valor - fuso
			```
		displayFolder: ALL\Máquinas\0.Roll Former 3
		lineageTag: 4fad2356-9824-4b70-9188-b83f1b97beaf

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure P-R-RF3 =
			--Produção Restante Roll Former 3
			
			[D-P-RF3] - [P-RF3]
		displayFolder: ALL\Máquinas\0.Roll Former 3
		lineageTag: d8711896-9b06-47de-bb8f-6a57c3f51b95

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure T-C-R-RF3 =
			-- Tempo de Ciclo Restante RF3
			[T-R-RF3] / [P-R-RF3]
		formatString: 0.0000000000
		displayFolder: ALL\Máquinas\0.Roll Former 3
		lineageTag: e8aae69f-7f27-4dd8-9e0e-ede644273dcb

