	measure C-P-M = ```
			-- Comprimento Produzido Médio
			
			VAR qtd_comprimento =
			    COUNT('Produção'[RAIL_ID])
			
			VAR soma_comprimento =
			    SUMX(
			        FILTER(
			            'Produção',
			            'Produção'[ITEM(m)] <> BLANK()
			        ),
			        'Produção'[ITEM(m)]
			    )
			
			VAR media_pond =
			    DIVIDE(soma_comprimento, qtd_comprimento)
			
			RETURN
			    
			media_pond
			
			
			```
		formatString: 0.00000000
		displayFolder: ALL\9.Estoque
		lineageTag: f91a37a4-12e4-4bff-979d-4a1690ed3178

