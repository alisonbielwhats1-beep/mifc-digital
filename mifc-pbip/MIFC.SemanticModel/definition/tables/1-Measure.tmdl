	measure R-C-RF3 =
			-- Regra Condicional RF3
			CALCULATE(
			IF(
			    [T-C-RF3] < [TKT-C-RF3] , 1 , 0 ),
			    'Calendar'[Date] = TODAY()
			)
		formatString: 0
		displayFolder: ALL\Máquinas\0.Roll Former 3
		lineageTag: f42dc10e-b742-4568-8cef-08a233a67302

	measure R-C-B1 =
			-- Regra Condicional Beatty 1
