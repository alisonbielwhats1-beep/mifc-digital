	measure R-C-RF2 =
			-- Regra Condicional RF2
			CALCULATE(
			IF(
			    [T-C-RF2] < [TKT-C-RF2] , 1 , 0 ),
			    'Calendar'[Date] = TODAY()
			)
		formatString: 0
		displayFolder: ALL\Máquinas\Roll Former 2
		lineageTag: 5c1eae37-4e4e-4b26-9171-eecd79187202

	measure P-LCT =
			--Produção Peças LCT
			SUM(
			    'Produção LCT'[_VALUE]
			)
		formatString: 0
		displayFolder: ALL\Máquinas\LCT
		lineageTag: ce3aae22-fb49-4159-a97f-37e11306951f

	measure P-P-LCT = ```
			--Paradas Programadas na LCT
			
			CALCULATE(
			    SUMX(Paradas,
			    Paradas[RETORNO] - Paradas[PARADA]) * 1440 ,
			    Paradas[CODIGO] IN {"L9", "O3", "M6", "O2"} && 
			    Paradas[OPERAÇÃO] = "LCT"
			)
			```
		displayFolder: ALL\Máquinas\LCT
		lineageTag: 98ec4c15-b79d-4c93-ab26-75c738d2a0fc

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure T-P-M-LCT =
			--Tempo de Produção LCT
			CALCULATE(
			
			SUM('Máquinas'[Tempo Disponível (Min)]),
			'Máquinas'[Máquina] = "LCT"
			)
		formatString: 0
		displayFolder: ALL\Máquinas\LCT
		lineageTag: 0bf56ff1-7038-4b3a-aa50-c9be64332008

	measure TKT-C-LCT =
			-- Takt Time Cliente LCT
			
			[T-P-M-LCT] / [D-P-RF2]
		displayFolder: ALL\Máquinas\LCT
		lineageTag: f6baac06-8c0f-4048-b9b5-2b4e45a52bea

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure T-D-L-LCT = ```
			--Tempo Disponível Liquído LCT
			
			var valor =
			
			
			SUM(
			    'Calendar'[Dia_Min]
			) - [P-P-LCT]
			
			var fuso = 
			
			[F-H]
			
			
			return
			
			valor - fuso
			```
		displayFolder: ALL\Máquinas\LCT
		lineageTag: 023960e7-8559-4f60-a9bd-5b3271458a05

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure T-C-LCT =
			--Tempo de Ciclo LCT
			
			[T-D-L-LCT]/[P-LCT]
		displayFolder: ALL\Máquinas\LCT
		lineageTag: 2369d265-3347-480d-9f09-a53438001265

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure P-R-LCT =
