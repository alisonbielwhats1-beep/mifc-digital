	measure C-P-M-TOTAL =
			
			-- Comprimento Produzido Médio Total
			
			VAR qtd_comprimento_DAF =
			    COUNTROWS(
			        FILTER(
			            'DAF SLITTERS',
			            'DAF SLITTERS'[FINISH_LENGTH] <> BLANK() && 'DAF SLITTERS'[Local]= "Slitter"
			        )
			    )
			
			VAR media_pond_DAF =
			    SUMX(
			        FILTER(
			            'DAF SLITTERS',
			            'DAF SLITTERS'[FINISH_LENGTH] <> BLANK() && 'DAF SLITTERS'[Local] = "Slitter"
			        ),
			        'DAF SLITTERS'[FINISH_LENGTH]
			    )
			
			VAR qtd_comprimento_FH =
			    COUNTROWS(
			        FILTER(
			            FH,
			            FH[FINISH_LENGHT] <> BLANK() && FH[local] = "Slitter"
			        )
			    )
			
			VAR media_pond_FH =
			    SUMX(
			        FILTER(
			            FH,
			            FH[FINISH_LENGHT] <> BLANK() && FH[local] = "Slitter"
			        ),
			        FH[FINISH_LENGHT]
			    )
			
			VAR qtd_comprimento_SCANIA =
			    COUNTROWS(
			        FILTER(
			            SCANIA,
			            SCANIA[FINISH_LENGHT] <> BLANK() && SCANIA[local] = "Slitter"
			        )
			    )
			
			VAR media_pond_SCANIA =
			    SUMX(
			        FILTER(
			            SCANIA,
			            SCANIA[FINISH_LENGHT] <> BLANK() && SCANIA[local] = "Slitter"
			        ),
			        SCANIA[FINISH_LENGHT]
			    )
			
			VAR qtd_comprimento_VM =
			    COUNTROWS(
			        FILTER(
			            VM,
			            VM[FINISH_LENGHT] <> BLANK() && VM[local] = "Slitter"
			        )
			    )
			
			VAR media_pond_VM =
			    SUMX(
			        FILTER(
			            VM,
			            VM[FINISH_LENGHT] <> BLANK() && VM[local]= "Slitter"
			        ),
			        VM[FINISH_LENGHT]
			    )
			
			VAR total_qtd_comprimento =
			    qtd_comprimento_DAF + qtd_comprimento_FH + qtd_comprimento_SCANIA + qtd_comprimento_VM
			
			VAR total_media_pond =
			    media_pond_DAF + media_pond_FH + media_pond_SCANIA + media_pond_VM
			
			RETURN
			   DIVIDE(total_media_pond, total_qtd_comprimento)
		formatString: 0.0
		displayFolder: ALL\0.0.MIFC\ALL
		lineageTag: 18f5eed1-c529-41c7-93a6-020a60510769

	measure E-M-P-S =
			-- Estoque Médio em Peças Pelo ShipDate
			
			ROUNDDOWN(
			IF(
			[C-T-E] / [C-P-M-TOTAL] = BLANK() , 0 , [C-T-E] / [C-P-M-TOTAL] ),0
			)
		formatString: 0
		displayFolder: ALL\0.0.MIFC\ALL\Estoque
		lineageTag: 36a67b84-af24-4607-947b-b5a17d87f81b

		annotation PBI_FormatHint = {"isDecimal":true}

	measure C-M-FL = ```
			-- Comprimento Finish Length
			VAR soma_sca = 
			SUMX(
			    FILTER(
			        SCANIA,
			        SCANIA[FINISH_LENGHT] <> BLANK() && SCANIA[LOCAL] = "Slitter"
			    ),
			    SCANIA[FINISH_LENGHT]
			)
			
			VAR soma_fh = 
			SUMX(
			    FILTER(
			        FH,
			        FH[FINISH_LENGHT] <> BLANK() && FH[LOCAL] = "Slitter"
			    ),
			    FH[FINISH_LENGHT]
			)
			
			VAR soma_vm = 
			SUMX(
			    FILTER(
			        VM,
			        VM[FINISH_LENGHT] <> BLANK() && VM[LOCAL] = "Slitter"
			    ),
			    VM[FINISH_LENGHT]
			)
			
			VAR soma_daf = 
			SUMX(
			    FILTER(
			        'DAF SLITTERS',
			        'DAF SLITTERS'[FINISH_LENGTH] <> BLANK() && 'DAF SLITTERS'[LOCAL] = "Slitter"
			    ),
			    ('DAF SLITTERS'[Pares Slitter] * 2) * 'DAF SLITTERS'[FINISH_LENGTH]
			)
			
			RETURN
			    soma_sca + soma_fh + soma_vm + soma_daf
			
			```
		formatString: 0
		displayFolder: ALL\0.0.MIFC\Logística
		lineageTag: 8c4c40c9-2f96-46ec-9822-ddb6c88e53f6

		annotation PBI_FormatHint = {"isDecimal":true}

	measure R-E-FL = ```
