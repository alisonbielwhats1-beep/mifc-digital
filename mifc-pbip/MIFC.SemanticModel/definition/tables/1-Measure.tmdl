	measure P-P-LPP2 = ```
			--Paradas Programadas na Pintura
			
			CALCULATE(
			    SUMX(Paradas,
			    Paradas[RETORNO] - Paradas[PARADA]) * 1440 ,
			    Paradas[CODIGO] IN {"L9", "O3", "M6", "O2"} && 
			    Paradas[OPERAÇÃO] = "PAINT LINE 02"
			)
			```
		displayFolder: ALL\Máquinas\Pintura
