	column Flatbed_2 = ```
			
			IF(
			    SCANIA[PLATAFORMA] = "" && MONTH(SCANIA[SHIP_DATE]) <= 9,
			    SCANIA[CUSTOMER_CODE] & "_" & SCANIA[ANO] & "0" & MONTH(SCANIA[SHIP_DATE]) & SCANIA[DIA] & "_" & SCANIA[FLATBED],
			    IF(
			        SCANIA[PLATAFORMA] = "" && MONTH(SCANIA[SHIP_DATE]) > 9,
			        SCANIA[CUSTOMER_CODE] & "_" & SCANIA[ANO] & MONTH(SCANIA[SHIP_DATE]) & SCANIA[DIA] & "_" & SCANIA[FLATBED],
			        SCANIA[PLATAFORMA]
			    )
			)
			
			```
		lineageTag: 06bbdfae-b297-4dfa-ad70-2b6c622bb6b0
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

