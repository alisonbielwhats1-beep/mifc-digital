	column local_revisado = ```
			
			            var vvin = SCANIA[CHASSIS_NUMBER]
			            var Vrept =   SCANIA[REPETIÇÃO]
			            var vtipo = SCANIA[REFORÇADA]
			            var Vmax = CALCULATE(sum(SCANIA[REPETIÇÃO]),FILTER(SCANIA,vvin = SCANIA[CHASSIS_NUMBER]  && vtipo  = "Reforçada" ))
			return
			      IF ( Vmax > 30 , "Estoque FG" , SCANIA[local])
			```
		lineageTag: 496c5b54-fc18-4372-a7b6-9a92b86ef83e
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column REPETIÇÃO = ```
			
			            var vvin = SCANIA[CHASSIS_NUMBER]
			        
			return
			            CALCULATE(count(SCANIA[CHASSIS_NUMBER]),FILTER(SCANIA, vvin = SCANIA[CHASSIS_NUMBER] ))
			```
		formatString: 0
		lineageTag: d0e94031-0c54-4fb2-91ec-31bf779eeff2
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'local_revisado stenhoj' = IF(SCANIA[TIPO] = "Reforço" && SCANIA[local_revisado] = "Ag. Stenhøj","",SCANIA[local_revisado])
		lineageTag: cfb7decb-5d7e-47c4-ae5f-a18e0f977c10
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'QTD LONG REF' = IF(SCANIA[TIPO]="Longarina",IF(SCANIA[REFORÇADA] ="Reforçada",1,0),0)
		formatString: 0
		lineageTag: bad1c19b-227e-4917-80d3-7fb2bb9e201e
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'QTD long SIMPLES' = IF(SCANIA[TIPO]="Longarina",if(SCANIA[REFORÇADA] = "",1,0),0)
		formatString: 0
		lineageTag: 57ed8c79-120e-48bc-a65c-a1f7befe98cf
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'QTD CARROS REF' = IF(SCANIA[TIPO]="Conjunto",1,0)
		formatString: 0
		lineageTag: 5ee885a3-6c16-49a5-9f55-a41e7d0e53ea
		summarizeBy: sum

