SHIP_DATE BETWEEN (SYSDATE - 2) AND (SYSDATE + 30)#(lf)#(tab)AND W.WORK_ORDER_STATUS_ID = 2#(lf)#(lf)ORDER BY SHIP_DATE asc", CreateNavigationProperties=false]),
